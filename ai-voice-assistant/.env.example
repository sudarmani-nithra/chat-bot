# Google Gemini API Key
GEMINI_API_KEY=AIzaSyAvPbM6X0U0HNMPHaia1SIuNn3inW63AU0

# Application Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (MySQL with SQLite automatic fallback)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=voice_leads_db
USE_SQLITE_FALLBACK=true

# Telephony Configuration
# Options: 'simulated' (free dev mode), 'exotel', 'twilio'
TELEPHONY_PROVIDER=simulated

# Exotel Configuration (for Indian outbound calls)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public Webhook Base URL (e.g. ngrok tunnel or domain for callbacks)
WEBHOOK_BASE_URL=http://localhost:8000

# Text-to-Speech Network Toggle
ENABLE_TTS_NETWORK=false

