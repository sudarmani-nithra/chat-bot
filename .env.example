# Google Gemini API Key
# Obtain for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_AUDIO_MODEL=gemini-2.5-flash-preview-tts

# MongoDB Configuration (Saved ONLY at the end of the conversation)
# Provide local or MongoDB Atlas connection string:
MONGODB_URI=mongodb://localhost:27017/
# or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=voice_leads_db
MONGODB_COLLECTION=completed_conversations
